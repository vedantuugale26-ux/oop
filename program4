#include<iostream>
#include<string>



using namespace std;


class Book 
{
  private:
        int bookID;
        string title;
        string author;
        double price;
 
 public:

//default constuctor with default values

 Book()

{

 bookID=101;
 title="C++ Programming";
 author="Bjarne Stro";
 price=500;
}
 //Pameterizedcontructor

 Book(int id,string t,string a, double p)

{
 bookID=id;
 title=t;
 author=a;
 price=p;
}
 // function to display book deatils

 void display()

{
 cout<<"Book ID:"<<bookID<< endl;
 cout<<"Title:"<<title<< endl;
 cout<<"Author:"<<author<< endl;
 cout<<"Price:Rs"<<price<< endl;
 cout<<"---------"<< endl;
}
};
